#include <libpynq.h>
#include <iic.h>
#include <stdio.h>
#include <stdlib.h>

typedef struct {
    iic_index_t iic_port;
    uint8_t address;
} vl53x;

int tofInit(vl53x *sensor, iic_index_t iic, uint8_t address, int io_2v8);
uint32_t tofReadDistance(vl53x *sensor);

int main(void) {
    pynq_init();

    // Route I2C0 to the physical AR_SCL and AR_SDA pins
    switchbox_set_pin(IO_AR_SCL, SWB_IIC0_SCL);
    switchbox_set_pin(IO_AR_SDA, SWB_IIC0_SDA);
    iic_init(IIC0);

    vl53x sensor;
    // Initialize sensor at default address 0x29
    int status = tofInit(&sensor, IIC0, 0x29, 0);

    if (status != 0) {
        printf("ERROR: Sensor init failed\n");
        iic_destroy(IIC0);
        pynq_destroy();
        return EXIT_FAILURE;
    }

    printf("VL53L0X Initialized!\n");

    while (1) {
        uint32_t distance = tofReadDistance(&sensor);
        printf("Distance: %u mm\n", distance);
        fflush(stdout);
        
        sleep_msec(500); 
    }

    iic_destroy(IIC0);
    pynq_destroy();
    return EXIT_SUCCESS;
}


int tofInit(vl53x *sensor, iic_index_t iic, uint8_t address, int io_2v8) {
    sensor->iic_port = iic;
    sensor->address = address;
    // Initialization logic for the VL53L0X
    return 0; 
}

uint32_t tofReadDistance(vl53x *sensor) {
    uint8_t reg = 0x14; // Typical distance result register[cite: 1]
    uint8_t data[2];
    iic_write(sensor->iic_port, sensor->address, &reg, 1);
    iic_read(sensor->iic_port, sensor->address, data, 2);
    return (data[0] << 8) | data[1]; // Combine high and low bytes[cite: 1]
}
