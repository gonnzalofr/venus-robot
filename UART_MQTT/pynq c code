#include <libpynq.h>
#include <stdio.h>
#include <string.h>

// Define which UART port the ESP32 is plugged into (UART0 or UART1)
#define ESP32_UART UART0

/* =========================================================
   1. UART TRANSMISSION FUNCTION
========================================================= */
void send_to_esp32(const char* message) {
    int i = 0;
    
    // 1. Loop through the message string character by character
    while (message[i] != '\0') {
        // Send one byte at a time using the libpynq function
        uart_send(ESP32_UART, (uint8_t)message[i]);
        i++;
    }
    
    // 2. CRITICAL: Send the newline character so the ESP32 knows it's done
    uart_send(ESP32_UART, (uint8_t)'\n');
    
    // Optional: Print to the laptop screen just so you can see it working
    printf("Sent to ESP32: %s\n", message);
}

/* =========================================================
   2. EVENT REPORTING FUNCTIONS
========================================================= */
void report_cube(int x, int y, int size, const char* color, float temp) {
    char payload[128];
    snprintf(payload, sizeof(payload), "CUBE;%d;%d;%d;%s;%.1f", x, y, size, color, temp);
    send_to_esp32(payload);
}

void report_boundary(float angle, int x, int y) {
    char payload[128];
    snprintf(payload, sizeof(payload), "BOUNDARY;%.1f;%d;%d", angle, x, y);
    send_to_esp32(payload);
}

void report_obstacle(int x, int y, const char* type, int size, const char* color, float temp) {
    char payload[128];
    snprintf(payload, sizeof(payload), "OBSTACLE;%d;%d;%s;%d;%s;%.1f", x, y, type, size, color, temp);
    send_to_esp32(payload);
}

/* =========================================================
   3. MAIN LOOP
========================================================= */
int main(void) {
    // 1. Initialize the PYNQ board and all I/O
    pynq_init();
    
    /* NOTE: Depending on which physical pins you plugged the ESP32 into,
       you may need to route the pins using the switchbox here.
       Example: switchbox_set_pin(SWB_AR0, SWB_UART0_RX); */
       
    // 2. Initialize the UART channel
    uart_init(ESP32_UART);
    uart_reset_fifos(ESP32_UART);
    
    printf("System Booted. Ready to send events.\n");

    // --- YOUR ROBOT LOGIC GOES HERE ---
    // Example test:
    report_cube(10, 10, 3, "green", 38.5);
    report_boundary(90.0, 13, 12);
    
    // Clean up when the program ends
    pynq_destroy();
    return EXIT_SUCCESS;
}
