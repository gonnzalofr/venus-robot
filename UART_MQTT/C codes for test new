#include <libpynq.h>
#include <time.h>
#include "mqtt.h"

int main(void) {
    pynq_init();
    init_mqtt();
    
    srand(time(NULL));

   
    const char *colors[] = {"Red", "Blue", "Green", "Yellow"};
    int sizes[] = {10, 6, 30, 100};
    float temps[] = {25.25, 35.02, 300.60, 59.40};
    
   int x, y;
   int size;
   float temp;
   char color[32] = "Unknown"; 

    while(1) {
        int i = rand() % 4;
        
        
        send_mqtt(10, 20, colors[i], sizes[i], temps[i]);
        
        sleep_msec(5000);
        
       recv_mqtt(&x, &y, &size, &temp, color);
       
       
       printf("%i, %i, %i, %.2f, %s  \n", x, y ,size, temp, color);
       
       
    }

    pynq_destroy();
    return 0;
}  

