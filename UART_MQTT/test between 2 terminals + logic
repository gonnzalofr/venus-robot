import paho.mqtt.client as mqtt
import time
import matplotlib
matplotlib.use("TkAgg")
import matplotlib.pyplot as plt
import numpy as np
from matplotlib.colors import ListedColormap

# ===== TOPICS =====
TOPIC_A_SEND = "/pynqbridge/robot_66_1/send"
TOPIC_A_RECV = "/pynqbridge/robot_66_1/recv"

TOPIC_B_SEND = "/pynqbridge/robot_6_1/send"
TOPIC_B_RECV = "/pynqbridge/robot_6_1/recv"

# ===== STATE =====
robots = {
    "A": {"pos": None, "distance": None, "temp": None, "color": None},
    "B": {"pos": None, "distance": None, "temp": None, "color": None}
}

collision_active = False
map_grid = {}
update_needed = False

# ===== VISUAL MAP =====
def show_map():
    size = 20
    grid = np.zeros((size, size))

    # terrain
    for (x, y), val in map_grid.items():
        if 0 <= x < size and 0 <= y < size:
            if val == "free":
                grid[y][x] = 1
            elif val == "obstacle":
                grid[y][x] = 2
            elif val == "rock":
                grid[y][x] = 3
            elif val == "boundary":
                grid[y][x] = 4

    # robots (draw last)
    for r in robots:
        pos = robots[r]["pos"]
        if pos is not None:
            x, y = pos
            if 0 <= x < size and 0 <= y < size:
                grid[y][x] = 5  # robot

    plt.clf()

    cmap = ListedColormap([
        "white",      # unknown
        "lightgray",  # free
        "red",        # obstacle
        "green",      # rock
        "black",      # boundary
        "yellow"      # robot (FIXED)
    ])

    plt.imshow(grid, cmap=cmap, vmin=0, vmax=5)
    plt.title("Robot Map")
    plt.gca().invert_yaxis()
    plt.pause(0.01)

# ===== HELPERS =====
def get_robot(topic):
    if topic == TOPIC_A_SEND:
        return "A"
    elif topic == TOPIC_B_SEND:
        return "B"
    return None

def send(client_A, client_B, robot, msg):
    print(f"{robot}: {msg}")
    if robot == "A":
        client_A.publish(TOPIC_A_RECV, msg)
    elif robot == "B":
        client_B.publish(TOPIC_B_RECV, msg)

def update_map(pos, value):
    if pos is not None:
        map_grid[pos] = value

# ===== LOGIC =====
def handle_logic(client_A, client_B):
    global collision_active, update_needed

    # Collision
    if robots["A"]["pos"] and robots["B"]["pos"]:
        ax, ay = robots["A"]["pos"]
        bx, by = robots["B"]["pos"]

        if abs(ax - bx) < 3 and abs(ay - by) < 3:
            if not collision_active:
                print("Collision risk")
                send(client_A, client_B, "A", "STOP")
                send(client_A, client_B, "B", "STOP")
                collision_active = True
            return
        else:
            collision_active = False

    # Robot logic
    for r in robots:
        pos = robots[r]["pos"]
        d = robots[r]["distance"]
        t = robots[r]["temp"]
        c = robots[r]["color"]

        action_taken = False

        # Boundary
        if c == "black":
            print(f"{r}: boundary detected")
            update_map(pos, "boundary")

            send(client_A, client_B, r, "STOP")
            send(client_A, client_B, r, "MOVE;-5")
            send(client_A, client_B, r, "TURN;90")

            robots[r]["color"] = None
            action_taken = True

        # Distance obstacle
        elif d is not None and d < 10:
            print(f"{r}: obstacle detected")
            update_map(pos, "obstacle")

            send(client_A, client_B, r, "TURN;90")

            robots[r]["distance"] = None
            action_taken = True

        # Rock
        elif c == "green":
            print(f"{r}: rock detected")
            update_map(pos, "rock")

            send(client_A, client_B, r, "STOP")

            if t is not None:
                print(f"{r}: rock temperature = {t}")

            robots[r]["color"] = None
            action_taken = True

        # Colored obstacles
        elif c in ["red", "blue"]:
            print(f"{r}: obstacle ({c})")
            update_map(pos, "obstacle")

            send(client_A, client_B, r, "STOP")
            send(client_A, client_B, r, "TURN;90")

            robots[r]["color"] = None
            action_taken = True

        # Free space
        elif pos is not None:
            update_map(pos, "free")

        if not action_taken:
            send(client_A, client_B, r, "MOVE;10")

    update_needed = True

# ===== MQTT HANDLER =====
def on_message(client, userdata, msg):
    data = msg.payload.decode()
    topic = msg.topic

    robot = get_robot(topic)
    if robot is None:
        return

    print(f"\nRobot {robot}: {data}")

    try:
        if ";" in data:
            parts = data.split(";")
            cmd = parts[0]

            if cmd == "DIST":
                robots[robot]["distance"] = int(parts[1])

            elif cmd == "POS":
                robots[robot]["pos"] = (int(parts[1]), int(parts[2]))

        elif ":" in data:
            pairs = data.split(",")
            for p in pairs:
                key, value = p.split(":")

                if key == "temp":
                    robots[robot]["temp"] = int(value)

                elif key == "color":
                    robots[robot]["color"] = value

    except:
        print("Invalid message format")

    handle_logic(client_A, client_B)

# ===== MQTT SETUP =====
client_A = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)
client_A.username_pw_set("robot_66_1", "cSTY2NJS")
client_A.on_message = on_message
client_A.connect("mqtt.ics.ele.tue.nl", 1883)
client_A.subscribe(TOPIC_A_SEND)

client_B = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)
client_B.username_pw_set("robot_6_1", "f8rWApIb")
client_B.on_message = on_message
client_B.connect("mqtt.ics.ele.tue.nl", 1883)
client_B.subscribe(TOPIC_B_SEND)

print("System running with visual map")

plt.ion()
plt.figure()

client_A.loop_start()
client_B.loop_start()

# ===== MAIN LOOP =====
while True:
    if update_needed:
        show_map()
        update_needed = False

    time.sleep(0.05)
