#include <libpynq.h>
#include <iic.h>
#include "vl53l0x.h"
#include <stdio.h>
#include <stdlib.h>
#include <signal.h> // Added for signal handling
#include <stdbool.h>

volatile bool running = true;

void handle_sigint(int sig) {
    running = false;
}

int main(void) {
    // Register the signal handler
    signal(SIGINT, handle_sigint);

    pynq_init();

    // Route I2C0 to the physical AR_SCL and AR_SDA pins
    switchbox_set_pin(IO_AR_SCL, SWB_IIC0_SCL);
    switchbox_set_pin(IO_AR_SDA, SWB_IIC0_SDA);
    iic_init(IIC0);

    vl53x sensor;
    // Initialize sensor at default address 0x29
    int status = tofInit(&sensor, IIC0, 0x29, 0);

    if(status != 0) {
        printf("ERROR: Sensor init failed\n");
        iic_destroy(IIC0);
        pynq_destroy();
        return EXIT_FAILURE;
    }

    printf("VL53L0X Initialized! Press Ctrl+C to exit.\n");

    // Loop until Ctrl+C is pressed
    while (running) {
        uint32_t distance = tofReadDistance(&sensor);
        printf("Distance: %u mm\n", distance);
        fflush(stdout);
        
        sleep_msec(500); 
    }

    // Now this will run when you press Ctrl+C!
    printf("\nCleaning up...\n");
    iic_destroy(IIC0);
    pynq_destroy();
    return EXIT_SUCCESS;
}